# Neon Database URL
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require"

# GitHub OAuth Credentials
GITHUB_CLIENT_ID="your_github_oauth_app_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_app_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/callback"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Webhook Secret & JWT Secret
GITHUB_WEBHOOK_SECRET="generate_a_random_64_char_hex_string"
JWT_SECRET="generate_a_random_64_char_hex_string"

# Notifications (Slack Incoming Webhook — optional)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# AI Model Configuration (Google Gemini Key)
GEMINI_API_KEY="your_google_gemini_api_key"
